{
  "name": "pilab",
  "version": "0.1.0",
  "private": true,
  "description": "PiLab home-lab monitoring platform for Raspberry Pi projects.",
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "pnpm local",
    "local": "dotenv -e .env.local -- pnpm --parallel --filter @pilab/api --filter @pilab/dashboard dev",
    "pi": "dotenv -e .env.pi -- pnpm --parallel --filter @pilab/api --filter @pilab/dashboard dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "dotenv-cli": "^10.0.0"
  }
}
